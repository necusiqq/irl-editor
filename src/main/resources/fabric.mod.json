{
  "schemaVersion": 1,
  "id": "irl-redactor",
  "version": "${version}",
  "name": "IRL Redactor",
  "description": "Client-side ImGui light editor and shader patching tools.",
  "authors": ["qualet"],
  "license": "MIT",
  "icon": "assets/irl-redactor/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": ["org.qualet.irlredactor.IRLRedactorMod"],
    "client": ["org.qualet.irlredactor.client.IRLRedactorClient"]
  },
  "mixins": [
    {
      "config": "irl-redactor.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "irl-core": "1.2.0+26.3"
  },
  "breaks": {
    "bbs": "*"
  }
}
